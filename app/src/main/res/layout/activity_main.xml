<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageView
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:src="@drawable/ic_shield"
            android:layout_marginTop="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SecureShield"
            android:textSize="30sp"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.03"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Premium Protection"
            android:textSize="13sp"
            android:textColor="#607D8B"
            android:letterSpacing="0.15"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="24dp"
            android:layout_marginTop="36dp">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Real-Time Protection: ON"
                android:textSize="17sp"
                android:textColor="#00E676"
                android:gravity="center"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/scanResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No threats detected"
                android:textSize="14sp"
                android:textColor="#90A4AE"
                android:gravity="center"
                android:layout_marginTop="10dp" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="18dp"
                android:visibility="gone"
                android:progressTint="#00E676" />

        </LinearLayout>

        <Button
            android:id="@+id/scanButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Scan Now"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/bg_button_primary"
            android:layout_marginTop="28dp" />

        <Button
            android:id="@+id/protectButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Enable Protection"
            android:textColor="#4CAF50"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/bg_button_secondary"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/appsProtected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apps Protected: 0"
            android:textSize="12sp"
            android:textColor="#455A64"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
