<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="#0d1117">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@android:drawable/ic_lock_lock"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SecureShield"
        android:textSize="28sp"
        android:textColor="#ffffff"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Real-Time Protection: ON"
        android:textSize="16sp"
        android:textColor="#4caf50"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/scanResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No threats detected"
        android:textSize="14sp"
        android:textColor="#aaaaaa"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/scanButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scan Now"
        android:backgroundTint="#4caf50"
        android:textColor="#ffffff"
        android:layout_marginTop="32dp" />

    <Button
        android:id="@+id/protectButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enable Protection"
        android:backgroundTint="#2196f3"
        android:textColor="#ffffff"
        android:layout_marginTop="12dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="24dp"
        android:visibility="gone"
        android:progressTint="#4caf50" />

    <TextView
        android:id="@+id/appsProtected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Apps Protected: 0"
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginTop="32dp" />

</LinearLayout>w
